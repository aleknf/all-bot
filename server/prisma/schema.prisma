datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WorkspaceLicense {
  id               String          @id @default(uuid())
  licenseKey       String          @unique
  organizationName String
  maxSeats         Int             @default(5)
  maxAgents        Int             @default(10)
  isActive         Boolean         @default(true)
  expiresAt        DateTime?
  createdAt        DateTime        @default(now())

  // Web Subscription Credentials (Tanpa API Key Berbayar)
  claudeSessionKey    String?
  geminiSecure1PSID   String?
  geminiSecure1PSIDTS String?

  // Optional Official API Keys
  geminiApiKey        String?
  openaiApiKey        String?

  devices          DeviceSession[]
  users            User[]
  agents           Agent[]
  channels         Channel[]
  providers        LlmProvider[]
  mcpServers       McpServer[]
  memories         Memory[]
  schedules        ScheduledTask[]
}

// Provider LLM kompatibel OpenAI (Nous Portal, OpenRouter, OpenAI, atau endpoint kustom)
model LlmProvider {
  id           String           @id @default(uuid())
  licenseId    String
  name         String
  kind         String           @default("custom") // nous, openrouter, openai, custom
  baseUrl      String
  apiKey       String?
  defaultModel String?
  createdAt    DateTime         @default(now())

  license      WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agents       Agent[]
}

model McpServer {
  id        String           @id @default(uuid())
  licenseId String
  name      String
  transport String           @default("http") // http, stdio
  url       String?
  headers   String?          // JSON object
  command   String?
  args      String?          // JSON array
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())

  license   WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, name])
}

// Memori jangka panjang lintas sesi. agentId null = dibagi ke semua agen.
model Memory {
  id        String           @id @default(uuid())
  licenseId String
  agentId   String?
  content   String
  createdAt DateTime         @default(now())

  license   WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  agent     Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([licenseId, createdAt])
}

model ScheduledTask {
  id         String           @id @default(uuid())
  licenseId  String
  name       String
  cron       String
  timezone   String           @default("Asia/Jakarta")
  prompt     String
  channelId  String
  agentId    String?
  enabled    Boolean          @default(true)
  lastRunAt  DateTime?
  lastStatus String?          // OK, ERROR
  lastError  String?
  createdAt  DateTime         @default(now())

  license    WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  channel    Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agent      Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model DeviceSession {
  id           String           @id @default(uuid())
  deviceId     String
  licenseId    String
  userId       String?
  deviceName   String?
  ipAddress    String?
  lastActiveAt DateTime         @default(now())
  createdAt    DateTime         @default(now())

  license      WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([licenseId, deviceId])
}

model User {
  id           String           @id @default(uuid())
  licenseId    String
  email        String           @unique
  name         String
  passwordHash String?
  role         String           @default("MEMBER") // ADMIN, MEMBER, GUEST
  avatarUrl    String?
  createdAt    DateTime         @default(now())

  license      WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  devices      DeviceSession[]
  messages     Message[]
}

model Agent {
  id           String           @id @default(uuid())
  licenseId    String
  name         String
  avatarUrl    String?
  description  String?
  systemPrompt String
  model        String           @default("gemini-2.5-flash")
  temperature  Float            @default(0.7)
  isActive     Boolean          @default(true)
  providerId   String?          // null = jalur lama (Claude/Gemini web session, API key lisensi)
  toolsEnabled Boolean          @default(false)
  createdAt    DateTime         @default(now())

  license      WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  provider     LlmProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  channels     ChannelAgent[]
  messages     Message[]
  memories     Memory[]
  schedules    ScheduledTask[]
}

model Channel {
  id            String           @id @default(uuid())
  licenseId     String
  name          String
  slug          String           @unique
  description   String?
  instructions  String?          // konteks/aturan channel, ditambahkan ke system prompt agen
  type          String           @default("INTERNAL_ROOM") // INTERNAL_ROOM, PUBLIC_LINK, DIRECT_AGENT
  autoReplyMode String           @default("ALWAYS")        // ALWAYS, MENTION_ONLY, MANUAL
  createdAt     DateTime         @default(now())

  license       WorkspaceLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assignedAgents ChannelAgent[]
  messages      Message[]
  schedules     ScheduledTask[]
}

model ChannelAgent {
  channelId String
  agentId   String

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([channelId, agentId])
}

model Message {
  id         String     @id @default(uuid())
  channelId  String
  senderType String     // USER, AGENT, SYSTEM
  senderName String?
  userId     String?
  agentId    String?
  content    String
  createdAt  DateTime   @default(now())

  channel    Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent      Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}
